{
  "name": "gymforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite\" \"node --watch --env-file=.env server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env server/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "prisma": "^6.0.0",
    "vite": "^5.4.8"
  }
}
